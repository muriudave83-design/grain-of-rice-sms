generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  name               String
  email              String              @unique
  password           String
  createdAt          DateTime            @default(now())
  role               Role
  mustChangePassword Boolean             @default(true)
  isActive           Boolean             @default(true)
  isArchived         Boolean             @default(false)
  lastLoginAt        DateTime?           @db.Timestamp(6)
  updatedAt          DateTime?           @db.Timestamp(6)
  attendanceSessions AttendanceSession[]
  disciplineRecords  Discipline[]        @relation("UserDisciplineRecords")
  guardians          Guardian[]          @relation("UserToGuardian")
  invoices           Invoice[]           @relation("AccountantInvoices")
  parentStudents     ParentStudent[]     @relation("ParentLinks")
  sponsorships       Sponsorship[]
  studentProfile     Student?
  taughtSubjects     Subject[]           @relation("TeacherSubjectsLegacy")
  teacherSubjects    TeacherSubject[]
}

model Student {
  id                Int               @id @default(autoincrement())
  firstName         String
  lastName          String
  createdAt         DateTime          @default(now())
  admissionNo       String            @unique
  dob               DateTime?
  userId            Int?              @unique
  classId           Int
  assessmentScores  AssessmentScore[]
  attendanceEntries AttendanceEntry[]
  disciplines       Discipline[]
  enrollments       Enrollment[]
  grades            Grade[]
  guardians         Guardian[]
  invoices          Invoice[]
  parentLinks       ParentStudent[]
  reportCards       ReportCard[]
  sponsorships      Sponsorship[]
  class             Class             @relation(fields: [classId], references: [id])
  user              User?             @relation(fields: [userId], references: [id])
}

model Class {
  id                 Int                 @id @default(autoincrement())
  name               String
  level              String?
  createdAt          DateTime            @default(now())
  assessments        Assessment[]
  attendanceSessions AttendanceSession[]
  classSubjects      ClassSubject[]
  reportCards        ReportCard[]
  students           Student[]
  teacherSubjects    TeacherSubject[]
}

model Guardian {
  id        Int      @id @default(autoincrement())
  userId    Int
  studentId Int
  relation  String?
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
  user      User     @relation("UserToGuardian", fields: [userId], references: [id])

  @@unique([userId, studentId])
}

model ParentStudent {
  id        Int     @id @default(autoincrement())
  parentId  Int
  studentId Int
  parent    User    @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Sponsorship {
  id        Int      @id @default(autoincrement())
  sponsorId Int
  studentId Int
  notes     String?
  createdAt DateTime @default(now())
  sponsor   User     @relation(fields: [sponsorId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([sponsorId, studentId])
}

model Subject {
  id              Int                      @id @default(autoincrement())
  name            String
  code            String?                  @unique
  createdAt       DateTime                 @default(now())
  teacherId       Int?
  assessments     Assessment[]
  classSubjects   ClassSubject[]
  enrollments     Enrollment[]
  grades          Grade[]
  reportEntries   ReportCardSubjectEntry[]
  teacher         User?                    @relation("TeacherSubjectsLegacy", fields: [teacherId], references: [id])
  teacherSubjects TeacherSubject[]
}

model ClassSubject {
  id        Int     @id @default(autoincrement())
  classId   Int
  subjectId Int
  class     Class   @relation(fields: [classId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  studentId Int
  subjectId Int
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
}

model Assessment {
  id          Int                 @id @default(autoincrement())
  title       String
  subjectId   Int
  classId     Int
  termId      Int
  date        DateTime
  type        String
  weight      Float
  maxScore    Float
  isPublished Boolean             @default(false)
  createdAt   DateTime            @default(now())
  status      AssessmentStatus    @default(DRAFT)
  categoryId  Int?
  category    AssignmentCategory? @relation(fields: [categoryId], references: [id])
  class       Class               @relation(fields: [classId], references: [id])
  subject     Subject             @relation(fields: [subjectId], references: [id])
  term        Term                @relation(fields: [termId], references: [id])
  scores      AssessmentScore[]
}

model AssessmentScore {
  id           Int        @id @default(autoincrement())
  assessmentId Int
  studentId    Int
  score        Float
  createdAt    DateTime   @default(now())
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
}

model Grade {
  id        Int     @id @default(autoincrement())
  studentId Int
  subjectId Int
  average   Float
  termId    Int
  total     Float
  student   Student @relation(fields: [studentId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  term      Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, subjectId, termId])
}

model Discipline {
  id           Int      @id @default(autoincrement())
  date         DateTime @default(now())
  studentId    Int
  recordedById Int?
  notes        String?
  type         String
  recordedBy   User?    @relation("UserDisciplineRecords", fields: [recordedById], references: [id])
  student      Student  @relation(fields: [studentId], references: [id])
}

model Invoice {
  id          Int       @id @default(autoincrement())
  studentId   Int
  amount      Float
  status      String
  issuedAt    DateTime  @default(now())
  dueDate     DateTime?
  notes       String?
  createdById Int?
  createdBy   User?     @relation("AccountantInvoices", fields: [createdById], references: [id])
  student     Student   @relation(fields: [studentId], references: [id])
}

model Term {
  id           Int          @id @default(autoincrement())
  name         String
  startDate    DateTime
  endDate      DateTime
  academicYear String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assessments  Assessment[]
  grades       Grade[]
  reportCards  ReportCard[]
}

model ReportCard {
  id          Int                      @id @default(autoincrement())
  studentId   Int
  termId      Int
  classId     Int
  average     Float
  generatedAt DateTime                 @default(now())
  publishedAt DateTime?
  total       Float
  status      ReportCardStatus
  class       Class                    @relation(fields: [classId], references: [id])
  student     Student                  @relation(fields: [studentId], references: [id])
  term        Term                     @relation(fields: [termId], references: [id])
  subjects    ReportCardSubjectEntry[]

  @@unique([studentId, termId])
}

model ReportCardSubjectEntry {
  id           Int        @id @default(autoincrement())
  reportCardId Int
  subjectId    Int
  average      Float
  total        Float
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id])
  subject      Subject    @relation(fields: [subjectId], references: [id])

  @@unique([reportCardId, subjectId])
}

model AttendanceSession {
  id        Int                     @id @default(autoincrement())
  classId   Int
  teacherId Int
  date      DateTime
  status    AttendanceSessionStatus @default(DRAFT)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  entries   AttendanceEntry[]
  class     Class                   @relation(fields: [classId], references: [id])
  teacher   User                    @relation(fields: [teacherId], references: [id])

  @@unique([classId, date])
}

model AttendanceEntry {
  id                  Int               @id @default(autoincrement())
  attendanceSessionId Int
  studentId           Int
  status              AttendanceStatus
  note                String?
  createdAt           DateTime          @default(now())
  session             AttendanceSession @relation(fields: [attendanceSessionId], references: [id])
  student             Student           @relation(fields: [studentId], references: [id])

  @@unique([attendanceSessionId, studentId])
}

model AuditLog {
  id          String      @id @default(uuid())
  actorUserId String
  actorRole   String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  action      AuditAction
}

model AssignmentCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  weight      Float        @default(1)
  assessments Assessment[]
}

model TeacherSubject {
  id        Int      @id @default(autoincrement())
  teacherId Int
  subjectId Int
  classId   Int
  createdAt DateTime @default(now())

  teacher User    @relation(fields: [teacherId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([teacherId, subjectId, classId])
}

enum Role {
  ADMIN
  TEACHER
  ACCOUNTANT
  PARENT
  SPONSOR
  STUDENT
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
}

enum ReportCardStatus {
  GENERATED
  PUBLISHED
}

enum AttendanceSessionStatus {
  DRAFT
  SUBMITTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_PASSWORD_RESET
  USER_LOGIN
  REPORT_CARDS_PUBLISHED
  REPORT_CARDS_UNPUBLISHED
  PASSWORD_CHANGED
  ATTENDANCE_SUBMITTED
}
